# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Gmail account used to send form notification emails
GMAIL_USER=youraccount@gmail.com

# Gmail App Password (not your regular password)
# Create one at https://myaccount.google.com/apppasswords
# (requires 2-Step Verification to be enabled on the Gmail account)
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Where form submissions should be sent (defaults to GMAIL_USER if not set)
NOTIFY_EMAIL=can613ada@gmail.com
